# Settings of the just recipes. Copy to .env (not in git) and fill in.

# Data directory of the old server, a copy of s3://hivwholeweb-data, outside git.
# The default lies next to the main checkout: ../hivwholeweb_data.
HIVWHOLEWEB_DATA=

# Build settings. Origin of the data host, without a trailing slash: the build
# points the data URLs of the pages to it. Empty means https://data.hiv.neherlab.org;
# http://127.0.0.1:8081 uses `just serve-data`. In CI, the repository variable of
# the same name.
HIVWHOLEWEB_DATA_URL=
# Domain under which the pages report visits to Plausible; empty for no
# analytics. Only the production build sets it (repository variable in CI).
HIVWHOLEWEB_PLAUSIBLE_DOMAIN=

# Port of `just serve-data`, the local data host (`just serve` reads PORT).
DATA_PORT=8081

# Production page host, for just publish-site. In CI, the repository variables of
# the same names; the credentials come from the role of
# HIVWHOLEWEB_SITE_AWS_ROLE_ARN.
HIVWHOLEWEB_SITE_AWS_DEFAULT_REGION=eu-central-1
HIVWHOLEWEB_SITE_AWS_S3_BUCKET=hivwholeweb-site
HIVWHOLEWEB_SITE_AWS_CLOUDFRONT_DISTRIBUTION_ID=
HIVWHOLEWEB_SITE_AWS_KVS_ARN=

# Preview host, for just publish-preview. In CI, the organization secrets and the
# organization variable of the same names.
PREVIEWS_NEHERLAB_CLICK_DOMAIN=previews.neherlab.click
PREVIEWS_NEHERLAB_CLICK_AWS_ACCESS_KEY_ID=
PREVIEWS_NEHERLAB_CLICK_AWS_SECRET_ACCESS_KEY=
PREVIEWS_NEHERLAB_CLICK_AWS_DEFAULT_REGION=
PREVIEWS_NEHERLAB_CLICK_AWS_S3_BUCKET=
PREVIEWS_NEHERLAB_CLICK_AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Data host, for just data-verify and just data-deploy. The credentials come from
# the standard AWS variables, for example `aws-vault exec <profile> --`, which
# must use a regional STS endpoint (the key store API needs its session tokens).
HIVWHOLEWEB_DATA_AWS_DEFAULT_REGION=eu-central-1
HIVWHOLEWEB_DATA_AWS_S3_BUCKET=hivwholeweb-data-public
HIVWHOLEWEB_DATA_AWS_S3_SOURCE_BUCKET=hivwholeweb-data
HIVWHOLEWEB_DATA_AWS_CLOUDFRONT_DISTRIBUTION_ID=
HIVWHOLEWEB_DATA_AWS_KVS_ARN=
