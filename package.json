{
  "name": "hivwholeweb-static",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt 'scripts/**/*.ts' 'server/**/*.ts' 'src/**/*.{html,css,js}' '!src/static/components/**'",
    "format-check": "oxfmt --check 'scripts/**/*.ts' 'server/**/*.ts' 'src/**/*.{html,css,js}' '!src/static/components/**'",
    "lint": "oxlint --deny-warnings scripts server src/static/eti",
    "serve": "bun server/serve.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.1156.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/crc64-nvme": "3.972.45",
    "@aws-sdk/signature-v4a": "3.1138.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
