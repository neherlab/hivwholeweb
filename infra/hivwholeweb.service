[Unit]
Description=Hivwholeweb service
Requires=docker.service
After=docker.service

[Service]
User=neherlab
Group=neherlab
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/home/neherlab/hivwholeweb
ExecStart=/usr/bin/bash /home/neherlab/hivwholeweb/scripts/run.sh
ExecStop=/usr/bin/bash /home/neherlab/hivwholeweb/scripts/stop.sh

[Install]
WantedBy=multi-user.target
